     Local manifest for POCO F7 / Redmi Turbo 4 Pro (onyx) on AOSPA (calcite).

     Copy this file to .repo/local_manifests/onyx.xml after:
       repo init -u https://github.com/AOSPA/manifest -b calcite
-->
<manifest>
  <remote name="lineageos" fetch="https://github.com/LineageOS" />

  <!-- Device -->
  <project path="device/xiaomi/onyx" name="Zarathos30/android_device_xiaomi_onyx" remote="github" revision="calcite" />
  <project path="device/xiaomi/onyx-miuicamera" name="Zarathos30/android_device_xiaomi_onyx-miuicamera" remote="github" revision="seventeen" />

  <!-- Prebuilt kernel (Image, dtbs, modules) -->
  <project path="device/xiaomi/onyx-kernel" name="Zarathos30/android_device_xiaomi_onyx-kernel-" remote="github" revision="calcite" clone-depth="1" />

  <!-- Hardware -->
  <project path="hardware/xiaomi" name="AOSPA/android_hardware_xiaomi" remote="github" revision="calcite" />
  <project path="hardware/qcom-caf/common" name="LineageOS/android_hardware_qcom-caf_common" remote="lineageos" revision="lineage-24.0">
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
  </project>
  <project path="hardware/qcom-caf/sm8750/audio/agm" name="LineageOS/android_vendor_qcom_opensource_agm" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/audio/graphservices" name="LineageOS/android_vendor_qcom_opensource_audioreach-graphservices" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/audio/pal" name="LineageOS/android_vendor_qcom_opensource_arpal-lx" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/audio/primary-hal" name="LineageOS/android_hardware_qcom_audio-ar" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/data-ipa-cfg-mgr" name="LineageOS/android_vendor_qcom_opensource_data-ipa-cfg-mgr" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/dataipa" name="LineageOS/android_vendor_qcom_opensource_dataipa" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/display/core" name="LineageOS/android_vendor_qcom_opensource_display-core" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/display/hal" name="LineageOS/android_hardware_qcom_display" remote="lineageos" revision="lineage-24.0-caf-sm8750" />
  <project path="hardware/qcom-caf/sm8750/display/intf" name="LineageOS/android_vendor_qcom_opensource_display-intf" remote="lineageos" revision="lineage-24.0-caf-sm8750" />

  <!-- Apps -->
  <project path="packages/apps/NotGameTurbo" name="Zarathos30/android_packages_apps_NotGameTurbo" remote="github" revision="seventeen" />

  <!-- Blobs -->
  <project path="vendor/xiaomi/onyx" name="Zarathos30/android_vendor_xiaomi_onyx" remote="github" revision="seventeen" />

  <!-- Kernel sources: only needed to rebuild the device/xiaomi/onyx-kernel
       prebuilts outside of the AOSPA tree. -->
  <!--
  <project path="kernel/xiaomi/sm8735" name="Zarathos30/android_kernel_xiaomi_sm8735" remote="github" revision="seventeen" />
  <project path="kernel/xiaomi/sm8735-modules" name="Zarathos30/android_kernel_xiaomi_sm8735-modules" remote="github" revision="seventeen" />
  -->
</manifest>
